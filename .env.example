# ==========================================
# LOCAL EXECUTION - Native PostgreSQL
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=urban_mobility_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ==========================================
# DOCKER COMPOSE
# ==========================================
DOCKER_POSTGRES_PASSWORD=change_me

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@urbanmobility.com

# Generate your own Fernet key.
AIRFLOW_FERNET_KEY=GENERATE_YOUR_OWN_FERNET_KEY

# Generate your own random secret.
AIRFLOW_WEBSERVER_SECRET_KEY=GENERATE_YOUR_OWN_SECRET

# ==========================================
# DATA PATHS AND LOGGING
# ==========================================
BRONZE_DIR=./data/bronze/yellow_taxi
SILVER_DIR=./data/silver/yellow_taxi
LOG_LEVEL=INFO